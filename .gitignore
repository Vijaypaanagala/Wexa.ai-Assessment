# Secrets — never commit connection details
.env
.env.local
*.pem
credentials*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Raw downloads (prepared subsample may be committed under data/prepared/)
data/raw/
*.gz
*.tar
*.zip
!data/prepared/.gitkeep

# Local live-run artifacts (committed published results live under results/published/)
results/runs/*
!results/runs/.gitkeep
# Generated chart scratch; committed charts live directly under charts/*.png
charts/out/

# Docker volumes
.docker-data/