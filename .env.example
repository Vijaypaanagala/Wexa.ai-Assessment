# Copy to .env and fill in. Never commit .env.
# Client machine region (for README / methodology): e.g. ap-south-1 / mumbai
CLIENT_REGION=ap-south-1

# --- CognoDB Cloud (free c0) ---
# Docs: https://cognodb.com/docs
# Signup: https://console.cognodb.com/signup
# URI form: bolt+s://<instance-id>.databases.cognodb.cloud
# User is typically "cognodb". Password is shown once at instance creation.
COGNODB_URI=
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j Aura Free ---
# Docs: https://neo4j.com/docs/python-manual/current/
# Console: https://console.neo4j.io/
# URI form: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memgraph (Docker, resource-capped) ---
# Docs: https://memgraph.com/docs/client-libraries/python
# Default local compose: bolt://localhost:7687 (auth disabled → empty user/password)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (Docker, resource-capped) ---
# Docs: https://docs.falkordb.com/getting-started/clients.html
# Official client: pip package "FalkorDB"
FALKORDB_URI=redis://localhost:6379
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=cognodb_bench

# --- ArangoDB (Docker, resource-capped) ---
# Docs: https://docs.arango.ai/ecosystem/drivers/python/
# Official client: python-arango
# ARANGO_PASSWORD must match docker-compose ARANGO_ROOT_PASSWORD
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=benchmark
ARANGO_DB=cognodb_bench
